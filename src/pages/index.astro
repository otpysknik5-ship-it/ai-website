---
import MainLayout from '../layouts/MainLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('blog');
// Сортируем по дате (новые сверху)
const sortedArticles = articles.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const pageTitle = "АЙ ВЕБ ДОМ — Как заработать с нуля. Нейросети и заработок.";
const pageDescription = "Честные обзоры нейросетей, гайды по генерации картинок и видео, крутые промпты и лайфхаки.";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <!-- Hero секция -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 leading-tight">
        Привет, я <span class="text-ai-accent">VLADIMIR</span> 👋
      </h1>
      <p class="text-xl md:text-2xl text-gray-400 mb-4">
        Создатель «АЙ ВЕБ ДОМ»
      </p>
      <p class="text-gray-400 leading-relaxed mb-8 max-w-2xl">
        Я АКТИВНО исследую нейросети и всё, что связано с искусственным интеллектом. 
        Пробовал десятки инструментов — от Midjourney до Grok, от HeyGen до SYNTX.
      </p>
      <p class="text-gray-500 mb-8">
        Этот сайт — моя личная лаборатория и дневник экспериментатора. 
        <strong class="text-white">Никакой воды, только честные обзоры и реальный опыт.</strong>
      </p>
      <div class="flex flex-wrap gap-3 text-sm text-gray-400">
        <span class="bg-gray-800 px-3 py-1 rounded-full">🎨 Генерация картинок</span>
        <span class="bg-gray-800 px-3 py-1 rounded-full">🎬 Видео</span>
        <span class="bg-gray-800 px-3 py-1 rounded-full">🤖 Нейросети</span>
        <span class="bg-gray-800 px-3 py-1 rounded-full">💰 Заработок</span>
      </div>
    </div>
  </section>

  <!-- Лента статей -->
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl md:text-3xl font-bold text-white">Все статьи</h2>
      <span class="text-gray-500 text-sm">{sortedArticles.length} статей</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedArticles.map(article => (
        <ArticleCard 
          title={article.data.title}
          description={article.data.description}
          image={article.data.image}
          slug={article.slug}
          date={article.data.date}
          tags={article.data.tags}
        />
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-4 py-12 mb-12">
    <div class="bg-gradient-to-r from-ai-accent/20 to-purple-600/20 rounded-2xl p-8 md:p-12 text-center border border-ai-accent/30">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Хочешь научиться зарабатывать с нейросетями?
      </h2>
      <p class="text-gray-400 mb-6 max-w-2xl mx-auto">
        Подпишись на Telegram-канал, чтобы получать свежие обзоры и лайфхаки первым.
      </p>
      <a href="https://t.me/aiwebdom" target="_blank" class="inline-block bg-ai-accent text-white px-8 py-3 rounded-xl font-bold hover:bg-indigo-600 transition-colors">
        Подписаться в Telegram
      </a>
    </div>
  </section>
</MainLayout>
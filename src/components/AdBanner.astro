---
interface Props {
  position: 'top' | 'bottom' | 'inline';
}

const { position } = Astro.props;
---

<div class={`my-6 p-4 bg-gradient-to-r from-gray-900 to-gray-800 rounded-xl border border-gray-700 ${position === 'inline' ? 'mx-0' : ''}`}>
  <a href="https://chad-ai.ru" target="_blank" rel="noopener" class="flex items-center gap-4 hover:opacity-90 transition-opacity">
    <div class="flex-1">
      <p class="text-ai-accent font-bold text-sm mb-1">💜 Chad AI — нейросеть на русском онлайн</p>
      <p class="text-gray-400 text-xs">Без VPN и SIM — Подписка от 290 руб/мес</p>
    </div>
    <span class="bg-ai-accent text-white px-4 py-2 rounded-lg text-sm font-bold whitespace-nowrap">
      Попробовать
    </span>
  </a>
</div>